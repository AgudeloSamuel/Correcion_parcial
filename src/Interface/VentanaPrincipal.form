<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Interface.VentanaPrincipal">
  <grid id="27dc6" binding="panelPrincipal" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false">
        <margin top="12" left="12" bottom="12" right="12"/>
    <margin top="12" left="12" bottom="12" right="12"/>
    <constraints>
      <xy x="20" y="20" width="900" height="650"/>
    </constraints>
    <properties>
      <property name="name" value="panelPrincipal"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="buttonsGrid" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="1" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="btnCirculo" class="javax.swing.JButton" binding="btnCirculo">
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Círculo"/></properties>
          </component>
          <component id="btnTriangulo" class="javax.swing.JButton" binding="btnTriangulo">
            <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Triángulo"/></properties>
          </component>
          <component id="btnCuadrilatero" class="javax.swing.JButton" binding="btnCuadrilatero">
            <constraints><grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Cuadrilátero"/></properties>
          </component>
          <component id="btnPentagono" class="javax.swing.JButton" binding="btnPentagono">
            <constraints><grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Pentágono"/></properties>
          </component>
        </children>
      </grid>
      <grid id="leftPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="2" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3"/>
        <margin top="0" left="0" bottom="0" right="0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <scrollpane id="scrollLista">
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties/>
            <border type="etched" title="Figuras"/>
            <children>
              <component id="listaFiguras" class="javax.swing.JList" binding="listaFiguras">
                <constraints/>
                <properties><property name="model" type="javax.swing.ListModel" editor="com.intellij.uiDesigner.core.ListModelEditor"><item value="Círculo"/><item value="Triángulo"/><item value="Cuadrilátero"/><item value="Pentágono"/></property></properties>
              </component>
            </children>
          </scrollpane>
          <scrollpane id="scrollInfo">
            <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties/>
            <border type="etched" title="Información"/>
            <children>
              <component id="txtInformacion" class="javax.swing.JTextArea" binding="txtInformacion">
                <constraints/>
                <properties>
                  <property name="editable" value="false"/>
                  <property name="lineWrap" value="true"/>
                  <property name="wrapStyleWord" value="true"/>
                  <property name="text" value="Selecciona una figura para ver su información."/>
                </properties>
              </component>
            </children>
          </scrollpane>
        </children>
      </grid>
      <grid id="panelDibujo" binding="panelDibujo" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="1" row-span="2" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3"/>
        <margin top="0" left="0" bottom="0" right="0"/>
        </constraints>
        <properties>
          <property name="preferredSize" class="java.awt.Dimension" value="450, 450"/>
        </properties>
        <border type="etched" title="Área de dibujo"/>
        <children/>
      </grid>
      <grid id="bottomPanel" layout-manager="GridLayoutManager" row-count="2" column-count="6" same-size-horizontally="false" same-size-vertically="false">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="lblDx" class="javax.swing.JLabel">
            <constraints><grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Desplazar X:"/></properties>
          </component>
          <component id="txtDx" class="javax.swing.JTextField" binding="txtDx">
            <constraints><grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="0"/></properties>
          </component>
          <component id="lblDy" class="javax.swing.JLabel">
            <constraints><grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Desplazar Y:"/></properties>
          </component>
          <component id="txtDy" class="javax.swing.JTextField" binding="txtDy">
            <constraints><grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="0"/></properties>
          </component>
          <component id="btnDesplazar" class="javax.swing.JButton" binding="btnDesplazar">
            <constraints><grid row="0" column="2" row-span="2" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Desplazar"/></properties>
          </component>
          <component id="btnComparar" class="javax.swing.JButton" binding="btnComparar">
            <constraints><grid row="0" column="4" row-span="2" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1"/>
        <margin top="0" left="0" bottom="0" right="0"/></constraints>
            <properties><property name="text" value="Comparar"/></properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
